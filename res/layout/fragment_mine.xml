<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 未登录 -->
        <LinearLayout
            android:id="@+id/login_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:background="@color/card_bg">

            <TextView
                android:id="@+id/btn_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/click_login"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:clickable="true" />
        </LinearLayout>

        <!-- 已登录用户信息 -->
        <LinearLayout
            android:id="@+id/user_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@color/card_bg"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="@dimen/avatar_large"
                android:layout_height="@dimen/avatar_large"
                android:background="@drawable/bg_circle_gray"
                android:scaleType="centerCrop"
                android:contentDescription="@string/tab_mine" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginLeft="16dp">

                <TextView
                    android:id="@+id/tv_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/click_login"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary" />

                <TextView
                    android:id="@+id/tv_user_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_coin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/textSecondary" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="8dp" android:background="@color/windowBackground" />

        <!-- 功能列表 -->
        <LinearLayout
            android:id="@+id/row_history"
            style="@style/ListItem"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/nav_history" android:textSize="15sp" android:textColor="@color/textPrimary" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_arrow_forward" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

        <LinearLayout
            android:id="@+id/row_favorite"
            style="@style/ListItem"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/nav_favorite" android:textSize="15sp" android:textColor="@color/textPrimary" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_arrow_forward" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

        <LinearLayout
            android:id="@+id/row_settings"
            style="@style/ListItem"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/nav_settings" android:textSize="15sp" android:textColor="@color/textPrimary" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_arrow_forward" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

        <LinearLayout
            android:id="@+id/row_about"
            style="@style/ListItem"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/nav_about" android:textSize="15sp" android:textColor="@color/textPrimary" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_arrow_forward" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="8dp" android:background="@color/windowBackground" />

        <TextView
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="14dp"
            android:text="@string/logout"
            android:textColor="@color/colorPrimary"
            android:textSize="15sp"
            android:background="@color/card_bg"
            android:visibility="gone"
            android:clickable="true" />
    </LinearLayout>
</ScrollView>
