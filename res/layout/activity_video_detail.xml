<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部封面 + 播放按钮 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/black">

            <ImageView
                android:id="@+id/iv_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/btn_play"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_badge"
                android:padding="12dp"
                android:src="@drawable/ic_play"
                android:clickable="true" />
        </FrameLayout>

        <!-- 标题 -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary" />

        <!-- UP 主信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/iv_owner_face"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:background="@drawable/bg_circle_gray"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tv_owner_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:textSize="14sp"
                android:textColor="@color/textPrimary" />

            <TextView
                android:id="@+id/btn_follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/bg_button_outline"
                android:text="@string/follow"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:clickable="true" />
        </LinearLayout>

        <!-- 数据行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">
            <TextView android:id="@+id/tv_stat_view" style="@style/StatItem" android:text="播放" />
            <TextView android:id="@+id/tv_stat_danmaku" style="@style/StatItem" android:text="弹幕" />
            <TextView android:id="@+id/tv_stat_reply" style="@style/StatItem" android:text="评论" />
            <TextView android:id="@+id/tv_stat_favorite" style="@style/StatItem" android:text="收藏" />
            <TextView android:id="@+id/tv_stat_coin" style="@style/StatItem" android:text="投币" />
            <TextView android:id="@+id/tv_stat_share" style="@style/StatItem" android:text="分享" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="8dp" android:background="@color/windowBackground" />

        <!-- 简介 -->
        <TextView
            android:id="@+id/tv_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/textSecondary"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_desc_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/desc_more"
            android:textColor="@color/colorPrimary"
            android:clickable="true" />

        <View android:layout_width="match_parent" android:layout_height="8dp" android:background="@color/windowBackground" />

        <!-- 互动按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/card_bg"
            android:padding="8dp">
            <TextView android:id="@+id/btn_like" style="@style/ActionItem"
                android:drawableTop="@drawable/ic_like" android:text="@string/like" />
            <TextView android:id="@+id/btn_coin" style="@style/ActionItem"
                android:drawableTop="@drawable/ic_coin" android:text="@string/coin" />
            <TextView android:id="@+id/btn_favorite" style="@style/ActionItem"
                android:drawableTop="@drawable/ic_favorite" android:text="@string/favorite" />
            <TextView android:id="@+id/btn_share" style="@style/ActionItem"
                android:drawableTop="@drawable/ic_share" android:text="@string/share" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="8dp" android:background="@color/windowBackground" />

        <!-- 分P -->
        <TextView
            android:id="@+id/tv_pages_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/pages"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary" />

        <ListView
            android:id="@+id/list_pages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@color/divider"
            android:dividerHeight="1dp"
            android:isScrollContainer="false" />

        <View android:layout_width="match_parent" android:layout_height="8dp" android:background="@color/windowBackground" />

        <!-- 评论 -->
        <TextView
            android:id="@+id/tv_comments_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/comments"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary" />

        <ListView
            android:id="@+id/list_comments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@color/divider"
            android:dividerHeight="1dp"
            android:isScrollContainer="false" />

        <TextView
            android:id="@+id/tv_comment_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/no_comment"
            android:textColor="@color/textSecondary"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
